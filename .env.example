# EasyAccess settings: copy this file to ".env" and fill in what you use.
# Every line is optional. Leave a line blank to skip that source.
# The links and passwords below are private, so never commit your .env (it's in .gitignore).

# ── Google Calendar ──────────────────────────────────────
# Google Calendar → Settings → your calendar → "Secret address in iCal format" (ends in .ics).
# Several calendars? Separate the links with commas.
GOOGLE_ICS=

# ── Email (via Gmail) ────────────────────────────────────
# The Gmail account to read (read-only). School/work mail can be auto-forwarded here.
GMAIL_USER=
# A Google *app password* (16 letters, needs 2-Step Verification), NOT your normal password.
GMAIL_APP_PASSWORD=
# Optional Gmail search to narrow the inbox, e.g. {from:myschool.edu to:myschool.edu}
GMAIL_FILTER=

# ── YouTube panel ────────────────────────────────────────
# Extra channels as topic:@handle, comma-separated. The topic becomes a tab.
# e.g. YOUTUBE_CHANNELS=fitness:@SomeLifter,tech:@SomeCoder
YOUTUBE_CHANNELS=
# Set to off to show only your own channels instead of the built-in fitness/tech picks
YOUTUBE_DEFAULTS=

# ── Sports (section below the dashboard) ─────────────────
# Leagues: nba, nfl, wnba, mlb, nhl
SPORTS_LEAGUES=nba,nfl
# Teams to star and filter, as ESPN abbreviations, e.g. ORL,MIA,JAX,TB
SPORTS_TEAMS=

# ── Gym tracker ──────────────────────────────────────────
# Your weekly routine, Sunday → Saturday (exactly 7 days). Use Rest for rest days.
GYM_ROUTINE=Rest,Push,Pull,Legs,Push,Pull,Legs

# ── Other ────────────────────────────────────────────────
PORT=3000
DAYS_AHEAD=14
